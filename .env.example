# Copy to .env before docker compose up. Never commit the real .env file.

# PostgreSQL
POSTGRES_DB=wedding
POSTGRES_USER=wedding
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_PORT=5432

# Spring Boot
SPRING_PROFILES_ACTIVE=prod
BACKEND_PORT=8080
APP_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
APP_ADMIN_FULL_NAME=Quản trị viên
APP_CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost,http://127.0.0.1
APP_SEED_DEMO_DATA=false
SPRINGDOC_ENABLED=false

# Angular (nginx)
FRONTEND_PORT=8081

# Local development (without Docker) — used by Spring Boot on the host
# DB_URL=jdbc:postgresql://localhost:5432/wedding
# DB_USERNAME=wedding
# DB_PASSWORD=wedding
# APP_UPLOAD_DIR=./uploads
# SPRING_PROFILES_ACTIVE=dev
# APP_SEED_DEMO_DATA=true
